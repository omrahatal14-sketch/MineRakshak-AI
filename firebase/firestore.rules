rules_version = '2';

// Primary access control lives in the Express backend (which uses the privileged Admin SDK
// and bypasses these rules entirely). These rules are defense-in-depth for any direct
// client reads/listeners the frontend adds later (e.g. a live notification badge), so a
// compromised or buggy frontend still can't read/write outside a user's role.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }
    function isMineOfficialOrAbove() {
      return isSignedIn() && role() in ['mine_official', 'corporate', 'admin'];
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isMineOfficialOrAbove());
      allow write: if isAdmin();
    }

    match /mines/{mineId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /inspections/{inspectionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && role() == 'field_officer'
                    && request.resource.data.inspectorId == request.auth.uid;
      allow update: if isMineOfficialOrAbove()
                    || (role() == 'field_officer' && resource.data.inspectorId == request.auth.uid);
      allow delete: if false;
    }

    match /observations/{observationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && role() in ['field_officer', 'mine_official', 'admin'];
      allow update: if isMineOfficialOrAbove();
      allow delete: if false;
    }

    match /violations/{violationId} {
      allow read: if isSignedIn();
      allow create: if isMineOfficialOrAbove() || role() == 'field_officer';
      allow update: if isMineOfficialOrAbove();
      allow delete: if false;
    }

    match /complianceRequirements/{reqId} {
      allow read: if isSignedIn();
      allow write: if isMineOfficialOrAbove();
    }

    match /correctiveActions/{actionId} {
      allow read: if isSignedIn();
      allow create: if isMineOfficialOrAbove();
      // assignee may update progress; verification/closure restricted to mine official+
      allow update: if isMineOfficialOrAbove()
                    || (isSignedIn() && resource.data.assignedTo == request.auth.uid);
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploadedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;  // backend-only (Admin SDK)
      allow delete: if false;
    }

    // Written only by the backend via the Admin SDK — never directly by clients.
    match /auditLogs/{logId} {
      allow read: if isMineOfficialOrAbove();
      allow write: if false;
    }

    match /riskScores/{riskScoreId} {
      allow read: if isMineOfficialOrAbove();
      allow write: if false;
    }
  }
}
